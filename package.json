{
  "name": "iledcolor-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:release": "node --test scripts/release-version.test.mjs",
    "version": "node scripts/release-version.mjs",
    "version:check": "node scripts/release-version.mjs --check",
    "e2e": "playwright test",
    "cap:sync": "npm run build && cap sync",
    "android:apk": "npm run cap:sync && cd android && gradlew assembleDebug",
    "android:release": "npm run cap:sync && cd android && gradlew assembleRelease",
    "ios:open": "npm run cap:sync && cap open ios",
    "icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/web-bluetooth": "^0.0.21",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@fontsource/press-start-2p": "^5.3.0"
  }
}
